  @@index([rentId], map: "rent_transact_rentId_fkey")
  @@index([shopId], map: "rent_transact_shopId_fkey")
  @@index([updatedById], map: "rent_transact_updatedById_fkey")
  @@index([userId], map: "rent_transact_userId_fkey")
}

