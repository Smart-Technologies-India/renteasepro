generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model user {
  id                            Int                      @id @default(autoincrement())
  username                      String?
  password                      String?
  firstName                     String?
  lastName                      String?
  contactone                    String?                  @unique
  contacttwo                    String?
  email                         String?                  @unique
  aadhar                        String?                  @unique
  pan                           String?                  @unique
  address                       String?                  @db.MediumText
  city                          String?
  bankName                      String?
  bankAccountNumber             String?
  ifscCode                      String?
  role                          Role                     @default(NONE)
  status                        Status                   @default(ACTIVE)
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  deletedAt                     DateTime?
  otp                           String?
  acount_category_create        account_category[]       @relation("account_category_createdBy_userId")
  acount_category_delete        account_category[]       @relation("account_category_deletedBy_userId")
  acount_category_update        account_category[]       @relation("account_category_updatedBy_userId")
  account_receipt_create        account_receipt[]        @relation("account_receipt_createdBy_userId")
  account_receipt_delete        account_receipt[]        @relation("account_receipt_deletedBy_userId")
  account_receipt_update        account_receipt[]        @relation("account_receipt_updatedBy_userId")
  bid_create                    bid[]                    @relation("bid_createdBy_userId")
  bid_delete                    bid[]                    @relation("bid_deletedBy_userId")
  bid_update                    bid[]                    @relation("bid_updatedBy_userId")
  bid_payment_create            bid_payment[]            @relation("bid_payment_createdBy_userId")
  bid_payment_delete            bid_payment[]            @relation("bid_payment_deletedBy_userId")
  bid_payment_update            bid_payment[]            @relation("bid_payment_updatedBy_userId")
  bid_payment                   bid_payment[]
  bid_transact_create           bid_transact[]           @relation("bid_transact_createdBy_userId")
  bid_transact_delete           bid_transact[]           @relation("bid_transact_deletedBy_userId")
  bid_transact_update           bid_transact[]           @relation("bid_transact_updatedBy_userId")
  bid_transact                  bid_transact[]
  corrigendum_create            corrigendum[]            @relation("corrigendum_createdBy_userId")
  corrigendum_delete            corrigendum[]            @relation("corrigendum_deletedBy_userId")
  corrigendum_update            corrigendum[]            @relation("corrigendum_updatedBy_userId")
  daily_property_create         daily_property[]         @relation("daily_property_createdBy_userId")
  daily_property_delete         daily_property[]         @relation("daily_property_deletedBy_userId")
  daily_property_update         daily_property[]         @relation("daily_property_updatedBy_userId")
  daily_rent_approvedBy_userId  daily_rent[]             @relation("daily_rent_approvedBy_userId")
  daily_rent_canceldBy_userId   daily_rent[]             @relation("daily_rent_canceldBy_userId")
  daily_rent_create             daily_rent[]             @relation("daily_rent_createdBy_userId")
  daily_rent_delete             daily_rent[]             @relation("daily_rent_deletedBy_userId")
  daily_rent_update             daily_rent[]             @relation("daily_rent_updatedBy_userId")
  daily_rent                    daily_rent[]
  daily_rent_description_create daily_rent_description[] @relation("daily_rent_description_createdBy_userId")
  daily_rent_description_delete daily_rent_description[] @relation("daily_rent_description_deletedBy_userId")
  daily_rent_description_update daily_rent_description[] @relation("daily_rent_description_updatedBy_userId")
  daily_rent_photo_create       daily_rent_photo[]       @relation("daily_rent_photo_createdBy_userId")
  daily_rent_photo_delete       daily_rent_photo[]       @relation("daily_rent_photo_deletedBy_userId")
  daily_rent_photo_update       daily_rent_photo[]       @relation("daily_rent_photo_updatedBy_userId")
  daily_rent_transact_create    daily_rent_transact[]    @relation("daily_rent_transact_createdBy_userId")
  daily_rent_transact_delete    daily_rent_transact[]    @relation("daily_rent_transact_deletedBy_userId")
  daily_rent_transact_update    daily_rent_transact[]    @relation("daily_rent_transact_updatedBy_userId")
  daily_rent_transact           daily_rent_transact[]
  daily_shop_create             daily_shop[]             @relation("daily_shop_createdBy_userId")
  daily_shop_delete             daily_shop[]             @relation("daily_shop_deletedBy_userId")
  daily_shop_update             daily_shop[]             @relation("daily_shop_updatedBy_userId")
  demand_node_create            demand_node[]            @relation("demand_node_createdBy_userId")
  demand_node_delete            demand_node[]            @relation("demand_node_deletedBy_userId")
  demand_node_update            demand_node[]            @relation("demand_node_updatedBy_userId")
  demand_node                   demand_node[]
  exempt_create                 exempt[]                 @relation("exempt_createdBy_userId")
  exempt_delete                 exempt[]                 @relation("exempt_deletedBy_userId")
  exempt_update                 exempt[]                 @relation("exempt_updatedBy_userId")
  file_upload_create            file_upload[]            @relation("upload_createdBy_userId")
  file_upload_delete            file_upload[]            @relation("upload_deletedBy_userId")
  file_upload_update            file_upload[]            @relation("upload_updatedBy_userId")
  file_upload                   file_upload[]
  misc_invoice_create           misc_invoice[]           @relation("misc_invoice_createdBy_userId")
  misc_invoice_delete           misc_invoice[]           @relation("misc_invoice_deletedBy_userId")
  misc_invoice_update           misc_invoice[]           @relation("misc_invoice_updatedBy_userId")
  organization_create           organization[]           @relation("organization_createdBy_userId")
  organization_delete           organization[]           @relation("organization_deletedBy_userId")
  organization_update           organization[]           @relation("organization_updatedBy_userId")
  property_create               property[]               @relation("property_createdBy_userId")
  property_delete               property[]               @relation("property_deletedBy_userId")
  property_update               property[]               @relation("property_updatedBy_userId")
  refund_amount_create          refund_amount[]          @relation("refund_amount_createdBy_userId")
  refund_amount_delete          refund_amount[]          @relation("refund_amount_deletedBy_userId")
  refund_amount_update          refund_amount[]          @relation("refund_amount_updatedBy_userId")
  refund_amount                 refund_amount[]
  rent_create                   rent[]                   @relation("rent_createdBy_userId")
  rent_delete                   rent[]                   @relation("rent_deletedBy_userId")
  rent_update                   rent[]                   @relation("rent_updatedBy_userId")
  rent                          rent[]
  rent_sms                      rent_sms[]
  rent_transact_create          rent_transact[]          @relation("rent_transact_createdBy_userId")
  rent_transact_delete          rent_transact[]          @relation("rent_transact_deletedBy_userId")
  rent_transact_update          rent_transact[]          @relation("rent_transact_updatedBy_userId")
  rent_transact                 rent_transact[]
  rentclose_create              rentclose[]              @relation("rentclose_createdBy_userId")
  rentclose_delete              rentclose[]              @relation("rentclose_deletedBy_userId")
  rentclose_update              rentclose[]              @relation("rentclose_updatedBy_userId")
  rentclose                     rentclose[]
  shop_create                   shop[]                   @relation("shop_createdBy_userId")
  shop_delete                   shop[]                   @relation("shop_deletedBy_userId")
  shop_update                   shop[]                   @relation("shop_updatedBy_userId")
  shop_category_create          shop_category[]          @relation("shop_category_createdBy_userId")
  shop_category_delete          shop_category[]          @relation("shop_category_deletedBy_userId")
  shop_category_update          shop_category[]          @relation("shop_category_updatedBy_userId")
  user_category_create          user_category[]          @relation("user_category_createdBy_userId")
  user_category_delete          user_category[]          @relation("user_category_deletedBy_userId")
  user_category_update          user_category[]          @relation("user_category_updatedBy_userId")
  user_doc_upload_create        user_doc_upload[]        @relation("user_doc_upload_createdBy_userId")
  user_doc_upload_delete        user_doc_upload[]        @relation("user_doc_upload_deletedBy_userId")
  user_doc_upload_update        user_doc_upload[]        @relation("user_doc_upload_updatedBy_userId")
  user_doc_upload               user_doc_upload[]
}

model shop_category {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  image       String?
  remarks     String?
  status      Status       @default(ACTIVE)
  createdAt   DateTime     @default(now())
  createdById Int
  updatedAt   DateTime     @updatedAt
  updatedById Int?
  deletedAt   DateTime?
  deletedById Int?
  daily_shop  daily_shop[]
  shop        shop[]
  createdBy   user         @relation("shop_category_createdBy_userId", fields: [createdById], references: [id])
  deletedBy   user?        @relation("shop_category_deletedBy_userId", fields: [deletedById], references: [id])
  updatedBy   user?        @relation("shop_category_updatedBy_userId", fields: [updatedById], references: [id])

  @@index([createdById], map: "shop_category_createdById_fkey")
  @@index([deletedById], map: "shop_category_deletedById_fkey")
  @@index([updatedById], map: "shop_category_updatedById_fkey")
}

model user_category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  image       String?
  remarks     String?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())
  createdById Int
  updatedAt   DateTime  @updatedAt
  updatedById Int?
  deletedAt   DateTime?
  deletedById Int?
  createdBy   user      @relation("user_category_createdBy_userId", fields: [createdById], references: [id])
  deletedBy   user?     @relation("user_category_deletedBy_userId", fields: [deletedById], references: [id])
  updatedBy   user?     @relation("user_category_updatedBy_userId", fields: [updatedById], references: [id])

  @@index([createdById], map: "user_category_createdById_fkey")
  @@index([deletedById], map: "user_category_deletedById_fkey")
  @@index([updatedById], map: "user_category_updatedById_fkey")
}

model property {
  id             Int           @id @default(autoincrement())
  name           String
  address        String
  locality       String
  pincode        String
  city           String
  contact_number String
  contact_person String
  total_shops    Int
  total_floors   Int
  latitude       Float
  longitude      Float
  description    String?
  image          String?
  remarks        String?
  priority       Int
  status         Status        @default(ACTIVE)
  createdAt      DateTime      @default(now())
  createdById    Int
  updatedAt      DateTime      @updatedAt
  updatedById    Int?
  deletedAt      DateTime?
  deletedById    Int?
  file_upload    file_upload[]
  createdBy      user          @relation("property_createdBy_userId", fields: [createdById], references: [id])
  deletedBy      user?         @relation("property_deletedBy_userId", fields: [deletedById], references: [id])
  updatedBy      user?         @relation("property_updatedBy_userId", fields: [updatedById], references: [id])
  shop           shop[]

  @@index([createdById], map: "property_createdById_fkey")
  @@index([deletedById], map: "property_deletedById_fkey")
  @@index([updatedById], map: "property_updatedById_fkey")
}

model shop {
  id             Int             @id @default(autoincrement())
  shopCategoryId Int
  propertyId     Int
  floor          Floors          @default(GROUND)
  shopNumber     String
  shopSize       String
  meterno        String?
  description    String?
  image          String?
  remarks        String?
  status         ShopStatus      @default(VACANT)
  createdAt      DateTime        @default(now())
  createdById    Int
  updatedAt      DateTime        @updatedAt
  updatedById    Int?
  deletedAt      DateTime?
  deletedById    Int?
  bid            bid[]
  bid_payment    bid_payment[]
  bid_transact   bid_transact[]
  demand_node    demand_node[]
  exempt         exempt[]
  file_upload    file_upload[]
  rent           rent[]
  rent_transact  rent_transact[]
  rentclose      rentclose[]
  createdBy      user            @relation("shop_createdBy_userId", fields: [createdById], references: [id])
  deletedBy      user?           @relation("shop_deletedBy_userId", fields: [deletedById], references: [id])
  property       property        @relation(fields: [propertyId], references: [id])
  shop_category  shop_category   @relation(fields: [shopCategoryId], references: [id])
  updatedBy      user?           @relation("shop_updatedBy_userId", fields: [updatedById], references: [id])

  @@unique([propertyId, shopNumber])
  @@index([createdById], map: "shop_createdById_fkey")
  @@index([deletedById], map: "shop_deletedById_fkey")
  @@index([shopCategoryId], map: "shop_shopCategoryId_fkey")
  @@index([updatedById], map: "shop_updatedById_fkey")
}

model bid {
  id                   Int            @id @default(autoincrement())
  shopId               Int
  title                String
  description          String?        @db.MediumText
  instruction          String?        @db.MediumText
  min_bid_amount       Int            @db.MediumInt
  bidincrementamount   PercentageType @default(PERCENTAGE)
  min_bid_increment    Int            @db.MediumInt
  fees                 PercentageType @default(PERCENTAGE)
  fees_amount          Int            @db.MediumInt
  fees_refundable      RefundType     @default(NONREFUNDABLE)
  emd                  PercentageType @default(PERCENTAGE)
  emd_amount           Int            @db.MediumInt
  emd_refundable       RefundType     @default(REFUNDABLE)
  bg                   PercentageType @default(PERCENTAGE)
  bg_amount            Int            @db.MediumInt
  bg_refundable        RefundType     @default(REFUNDABLE)
  docone               String?
  doconedescription    String?        @db.MediumText
  doctwo               String?
  doctwodescription    String?        @db.MediumText
  docthree             String?
  docthreedescription  String?        @db.MediumText
  bidstartdate         DateTime
  bidenddate           DateTime
  biddeclarationdate   DateTime
  t_and_c_file_number  String?        @db.MediumText
  t_and_c_description  String?        @db.MediumText
  t_and_c_upload       String?        @db.MediumText
  remarks              String?        @db.MediumText
  status               Status         @default(ACTIVE)
  createdAt            DateTime       @default(now())
  createdById          Int
  updatedAt            DateTime       @updatedAt
  updatedById          Int?
  deletedAt            DateTime?
  deletedById          Int?
  is_differently_abled Boolean        @default(false)
  is_exemption         Boolean        @default(false)
  is_msme              Boolean        @default(false)
  is_reserved          Boolean        @default(false)
  is_woman             Boolean        @default(false)
  is_auction           Boolean        @default(false)
  is_open              Boolean        @default(false)
  is_sc_st             Boolean        @default(false)
  is_tribal            Boolean        @default(false)
  bid_status           BidStatus      @default(DRAFT)
  additional_doc       Boolean        @default(false)
  createdBy            user           @relation("bid_createdBy_userId", fields: [createdById], references: [id])
  deletedBy            user?          @relation("bid_deletedBy_userId", fields: [deletedById], references: [id])
  shop                 shop           @relation(fields: [shopId], references: [id])
  updatedBy            user?          @relation("bid_updatedBy_userId", fields: [updatedById], references: [id])
  bid_payment          bid_payment[]
  bid_transact         bid_transact[]
  corrigendum          corrigendum[]
  exempt               exempt[]
  file_upload          file_upload[]

  @@index([createdById], map: "bid_createdById_fkey")
  @@index([deletedById], map: "bid_deletedById_fkey")
  @@index([shopId], map: "bid_shopId_fkey")
  @@index([updatedById], map: "bid_updatedById_fkey")
}

model rent {
  id                  Int             @id @default(autoincrement())
  shopId              Int
  userId              Int
  rent_amount         Int             @db.MediumInt
  rent_start_date     DateTime
  rent_end_date       DateTime
  due_date            Int
  rent_agreement_file String?         @db.MediumText
  chargeone           Int?            @db.MediumInt
  chargetwo           Int?            @db.MediumInt
  chargethree         Int?            @db.MediumInt
  remarks             String?         @db.MediumText
  status              RentStatus      @default(RUNNING)
  createdAt           DateTime        @default(now())
  createdById         Int
  updatedAt           DateTime        @updatedAt
  updatedById         Int?
  deletedAt           DateTime?
  deletedById         Int?
  corrigendum         corrigendum[]
  file_upload         file_upload[]
  createdBy           user            @relation("rent_createdBy_userId", fields: [createdById], references: [id])
  deletedBy           user?           @relation("rent_deletedBy_userId", fields: [deletedById], references: [id])
  shop                shop            @relation(fields: [shopId], references: [id])
  updatedBy           user?           @relation("rent_updatedBy_userId", fields: [updatedById], references: [id])
  user                user            @relation(fields: [userId], references: [id])
  rent_sms            rent_sms[]
  rent_transact       rent_transact[]
  rentclose           rentclose[]

  @@index([createdById], map: "rent_createdById_fkey")
  @@index([deletedById], map: "rent_deletedById_fkey")
  @@index([shopId], map: "rent_shopId_fkey")
  @@index([updatedById], map: "rent_updatedById_fkey")
  @@index([userId], map: "rent_userId_fkey")
}

model organization {
  id             Int       @id @default(autoincrement())
  name           String
  address        String?
  gst_no         String?
  gst_file       String?
  pan_no         String?
  pan_file       String?
  msmeno         String?
  msme_file      String?
  contact_person String?
  contact_number String?
  status         Status    @default(ACTIVE)
  createdAt      DateTime  @default(now())
  createdById    Int
  updatedAt      DateTime  @updatedAt
  updatedById    Int?
  deletedAt      DateTime?
  deletedById    Int?
  createdBy      user      @relation("organization_createdBy_userId", fields: [createdById], references: [id])
  deletedBy      user?     @relation("organization_deletedBy_userId", fields: [deletedById], references: [id])
  updatedBy      user?     @relation("organization_updatedBy_userId", fields: [updatedById], references: [id])

  @@index([createdById], map: "organization_createdById_fkey")
  @@index([deletedById], map: "organization_deletedById_fkey")
  @@index([updatedById], map: "organization_updatedById_fkey")
}

model bid_transact {
  id               Int           @id @default(autoincrement())
  bidId            Int
  userId           Int
  shopId           Int
  amount           Int           @db.MediumInt
  iswinningbid     Boolean?
  bidrejected      Boolean?
  rejectedreason   String?       @db.MediumText
  isexempt         Boolean?
  exemptcategory   String?       @db.MediumText
  exemptdocurl     String?       @db.MediumText
  biddocstatus     Boolean?
  transaction_date DateTime      @default(now())
  remarks          String?       @db.MediumText
  status           BidTransact   @default(PENDING)
  createdAt        DateTime      @default(now())
  createdById      Int
  updatedAt        DateTime      @updatedAt
  updatedById      Int?
  deletedAt        DateTime?
  deletedById      Int?
  biddocreason     String?       @db.MediumText
  userremarks      String?       @db.MediumText
  bid              bid           @relation(fields: [bidId], references: [id])
  createdBy        user          @relation("bid_transact_createdBy_userId", fields: [createdById], references: [id])
  deletedBy        user?         @relation("bid_transact_deletedBy_userId", fields: [deletedById], references: [id])
  shop             shop          @relation(fields: [shopId], references: [id])
  updatedBy        user?         @relation("bid_transact_updatedBy_userId", fields: [updatedById], references: [id])
  user             user          @relation(fields: [userId], references: [id])
  file_upload      file_upload[]

  @@index([bidId], map: "bid_transact_bidId_fkey")
  @@index([createdById], map: "bid_transact_createdById_fkey")
  @@index([deletedById], map: "bid_transact_deletedById_fkey")
  @@index([shopId], map: "bid_transact_shopId_fkey")
  @@index([updatedById], map: "bid_transact_updatedById_fkey")
  @@index([userId], map: "bid_transact_userId_fkey")
}

model exempt {
  id                     Int             @id @default(autoincrement())
  shopId                 Int
  bidId                  Int
  is_fees_exempt_allowed Boolean         @default(false)
  fees_for               ExemptFor?
  fees                   PercentageType? @default(PERCENTAGE)
  feesamount             Int?            @db.MediumInt
  is_bg_exempt_allowed   Boolean         @default(false)
  bg_for                 ExemptFor?
  bg                     PercentageType? @default(PERCENTAGE)
  bgamount               Int?            @db.MediumInt
  is_emd_exempt_allowed  Boolean         @default(false)
  emd_for                ExemptFor?
  emd                    PercentageType? @default(PERCENTAGE)
  emdamount              Int?            @db.MediumInt
  description            String?
  image                  String?
  remarks                String?
  status                 Status          @default(ACTIVE)
  createdAt              DateTime        @default(now())
  createdById            Int
  updatedAt              DateTime        @updatedAt
  updatedById            Int?
  deletedAt              DateTime?
  deletedById            Int?
  corrigendum            corrigendum[]
  bid                    bid             @relation(fields: [bidId], references: [id])
  createdBy              user            @relation("exempt_createdBy_userId", fields: [createdById], references: [id])
  deletedBy              user?           @relation("exempt_deletedBy_userId", fields: [deletedById], references: [id])
  shop                   shop            @relation(fields: [shopId], references: [id])
  updatedBy              user?           @relation("exempt_updatedBy_userId", fields: [updatedById], references: [id])

  @@index([bidId], map: "exempt_bidId_fkey")
  @@index([createdById], map: "exempt_createdById_fkey")
  @@index([deletedById], map: "exempt_deletedById_fkey")
  @@index([shopId], map: "exempt_shopId_fkey")
  @@index([updatedById], map: "exempt_updatedById_fkey")
}

