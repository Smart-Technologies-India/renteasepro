  createdBy        user           @relation("bid_payment_createdBy_userId", fields: [createdById], references: [id])
  deletedBy        user?          @relation("bid_payment_deletedBy_userId", fields: [deletedById], references: [id])
  shop             shop           @relation(fields: [shopId], references: [id])
  updatedBy        user?          @relation("bid_payment_updatedBy_userId", fields: [updatedById], references: [id])
  user             user           @relation(fields: [userId], references: [id])

  @@index([bidId], map: "bid_payment_bidId_fkey")
  @@index([createdById], map: "bid_payment_createdById_fkey")
